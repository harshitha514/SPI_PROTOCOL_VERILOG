module spi_master #(
parameter DATA_WIDTH = 8,
parameter CLK_DIV = 4
) (
	input wire clk,
	input wire rst,
	input wire [DATA_WIDTH-1:0] parallel_data,
	input wire data_valid,
	output reg spi_clk,
	output reg spi_cs,
	output reg spi_mosi,
	output reg [DATA_WIDTH-1:0]rx_data,
	input wire spi_miso
);

reg [DATA_WIDTH-1:0]tx_shift_reg;
reg [3:0] bit_count;
reg [1:0] state;
reg [15:0] clk_count;
reg spi_clk_en;
reg [DATA_WIDTH-1:0]rx_shift_reg;

//Edge detection
reg spi_clk_d;
wire falling_edge;
wire rising_edge;

localparam IDLE = 2'd0;
localparam LOAD = 2'd1;
localparam SHIFT = 2'd2;
localparam DONE = 2'd3;

//======================EDGE DETECTION======================

always @(posedge clk or negedge rst) begin
	if(!rst)
		spi_clk_d<=0;
	else
		spi_clk_d<=spi_clk; //clock gets in next cycle, bacause of non blocking assignment 
end

//Falling edge: sp
//spi_clk just went LOW

assign falling_edge = (!spi_clk && spi_clk_d);
assign rising_edge = (spi_clk && !spi_clk_d);

//================SPI CLOCK DIVIDER====================

always @(posedge clk or negedge rst) begin
	if(!rst) begin
		clk_count<=0;
		spi_clk<=0;
	end
	else if(spi_clk_en) begin
	if(clk_count == CLK_DIV -1) begin //clk_count=3
		clk_count <=0;
		spi_clk <= ~spi_clk;
	end
	else begin
		clk_count <= clk_count + 1'b1;
	end
end
else begin
	clk_count <=0;
	spi_clk<=0;
end
end

//==================FSM===================

always @(posedge clk or negedge rst) begin
	if(!rst) begin
		state <=IDLE;
		spi_cs <=1'b1; //active low
		spi_mosi <= 0;
		bit_count <= 0;
		spi_clk_en <= 0;
		tx_shift_reg <= 0;
		rx_shift_reg<={DATA_WIDTH{1'b0}};
		rx_data<= {DATA_WIDTH{1'b0}};

	end
	else begin
		case(state)
			IDLE: begin
				spi_cs <= 1'b1;
				spi_clk_en <=0;
				spi_mosi <= 0;

				if(data_valid)
					state<=LOAD;
			end

			LOAD: begin
				spi_cs <=1'b0;
				tx_shift_reg <= parallel_data; //store all 8 bits
				//tx_shift_reg<={tx_shift_reg[DATA_WIDTH-2:0], 1'b0};
				rx_shift_reg <={DATA_WIDTH{1'b0}};
				bit_count <= DATA_WIDTH - 1;

				spi_clk_en <=1;
				spi_mosi <= parallel_data[DATA_WIDTH-1]; //preload MSB
				state <= SHIFT;
			end

			SHIFT: begin
				if(falling_edge) begin
					
					if(bit_count==0) begin
						state <= DONE;
					end
					else begin
						bit_count <= bit_count -1'b1;
						//tx_shift_reg<={tx_shift_reg[DATA_WIDTH-2:0], 1'b0};

						spi_mosi <= tx_shift_reg[bit_count - 1];
					end
				end
				else if(rising_edge) begin
					rx_shift_reg <= {rx_shift_reg[DATA_WIDTH-2:0],spi_miso};
					if(bit_count==0) begin
						rx_data<={rx_shift_reg[DATA_WIDTH-2:0], spi_miso};
					end
				end

			end
			
			DONE: begin
				spi_cs <= 1'b1;
				spi_clk_en <= 0;
				spi_mosi <=0;
				state <= IDLE;
			end
		endcase
	end
end
endmodule
