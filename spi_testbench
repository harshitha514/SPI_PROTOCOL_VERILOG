module spi_top ;
    parameter DATA_WIDTH = 8;
    parameter CLK_DIV = 4;
    parameter COUNT_WIDTH = 4;
    reg clk;
    reg rst;

    reg [DATA_WIDTH-1:0] master_tx_data;
    reg [DATA_WIDTH-1:0] slave_tx_data;

    reg data_valid;

    wire [DATA_WIDTH-1:0] master_rx_data;
    wire [DATA_WIDTH-1:0] slave_rx_data;

    wire data_received;

wire spi_clk;
wire spi_cs;
wire spi_mosi;
wire spi_miso;

// MASTER INSTANTIATION
spi_master #(
    .DATA_WIDTH(DATA_WIDTH),
    .CLK_DIV(CLK_DIV)
) master_inst (
    .clk(clk),
    .rst(rst),
    .parallel_data(master_tx_data),
    .data_valid(data_valid),

    .spi_clk(spi_clk),
    .spi_cs(spi_cs),
    .spi_mosi(spi_mosi),
    .spi_miso(spi_miso),

    .rx_data(master_rx_data)
);

// SLAVE INSTANTIATION
spi_slave #(
    .DATA_WIDTH(DATA_WIDTH),
    .COUNT_WIDTH(COUNT_WIDTH)
) slave_inst (
    .rst(rst),
    .spi_clk(spi_clk),
    .spi_mosi(spi_mosi),
    .spi_cs(spi_cs),
    .parallel_data(slave_tx_data),

    .spi_miso(spi_miso),
    .rx_data(slave_rx_data),
    .data_received(data_received)
);

initial 
	clk=0;
always #5 clk=~clk;

initial begin
	rst=0;
	data_valid=0;
	master_tx_data=8'b10011010;
	slave_tx_data=8'b11110000;

	#20 rst=1;
	#20 data_valid=1;

	wait(spi_cs==1'b0);
	wait(spi_cs==1'b1);

	$display("MASTER_RX = %b",master_rx_data);
	$display("SLAVE_RX = %b",slave_rx_data);

	#20 rst=0;
	data_valid=0;
	master_tx_data=8'b11001100;
	slave_tx_data=8'b10101010;

	#20 rst=1;
	#20 data_valid=1;

	wait(spi_cs==1'b0);
	wait(spi_cs==1'b1);

	$display("MASTER_RX = %b",master_rx_data);
	$display("SLAVE_RX = %b",slave_rx_data);


	#20 $finish;
end
endmodule
